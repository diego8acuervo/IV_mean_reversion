{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Download IV (SPY)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/download_iv.py",
      "args": ["--symbol", "SPY"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
